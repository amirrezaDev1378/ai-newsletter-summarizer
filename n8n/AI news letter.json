      "parameters": {
        "jsCode": "function transformList(githubList) {\n  const dateGroups = {};\n\n  for (const item of githubList) {\n    // Expected path format: \"summerized/{date}/{filename}.md\"\n    const parts = item.path.split('/');\n    const date = parts.length >= 2 ? parts[1] : 'unknown';\n    \n    // Extract ID by removing the file extension\n    const id = item.name.replace(/\\.[^/.]+$/, '');\n\n    // Convert raw URL to the `refs/heads/...` structure if needed\n    const markdownLink = item.download_url\n      ? item.download_url.replace('/master/', '/refs/heads/master/')\n      : '';\n\n    if (!dateGroups[date]) {\n      dateGroups[date] = [];\n    }\n\n    dateGroups[date].push({\n      id,\n      markdownLink\n    });\n  }\n\n  return Object.entries(dateGroups).map(([date, items]) => ({\n    date,\n    items\n  }));\n}\n\n\nconst files = $(\"List Date Files\").all().map(i=>i.json)\n\nreturn {listJson:JSON.stringify(transformList(files))}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
