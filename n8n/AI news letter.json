      "parameters": {
        "jsCode": "function cleanHTMLString(html) {\n  // 1. Remove script, style, and iframe tags along with their contents\n  let clean = html.replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '');\n  clean = clean.replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '');\n  clean = clean.replace(/<iframe\\b[^<]*(?:(?!<\\/iframe>)<[^<]*)*<\\/iframe>/gi, '');\n\n  // 2. Allowed attributes whitelist\n  const allowedAttrs = new Set([\n    'href', 'src', 'srcset', 'alt', 'title', \n    'width', 'height', 'target', 'rel'\n  ]);\n\n  // 3. Process every HTML tag\n  return clean.replace(/<([a-zA-Z0-9]+)(\\s[^>]*)?(\\/?)>/g, (match, tagName, attrs, closingSlash) => {\n    if (!attrs) return match;\n\n    const keptAttrs = [];\n    // Matches key=\"value\", key='value', or bare key=value\n    const attrRegex = /([a-zA-Z0-9_-]+)(?:\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+)))?/g;\n    let attrMatch;\n\n    while ((attrMatch = attrRegex.exec(attrs)) !== null) {\n      const name = attrMatch[1].toLowerCase();\n      const value = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? '';\n\n      // Skip event handlers (onclick, onload, etc.)\n      if (name.startsWith('on')) continue;\n\n      // Skip pseudo-protocols like href=\"javascript:...\"\n      if ((name === 'href' || name === 'src') && /^javascript:/i.test(value.trim())) {\n        continue;\n      }\n\n      // Keep only whitelisted attributes\n      if (allowedAttrs.has(name)) {\n        keptAttrs.push(`${name}=\"${value}\"`);\n      }\n    }\n\n    const attrString = keptAttrs.length > 0 ? ' ' + keptAttrs.join(' ') : '';\n    const slash = closingSlash ? ' /' : '';\n    return `<${tagName}${attrString}${slash}>`;\n  });\n}\n\nlet htmls = []\n\nfor (const item of $input.all()) {\n  htmls.push({content:cleanHTMLString(item.json.html.join(\"\\n\")) , id:item.json.id})\n}\n\nreturn htmls"
      },
